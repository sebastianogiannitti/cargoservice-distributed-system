# Indirizzo IP della macchina host.
#
# I servizi si registrano su Eureka pubblicando questo indirizzo: deve essere
# raggiungibile dagli altri container e dal browser, quindi NON usare
# "localhost" ne' l'IP interno assegnato da Docker.
#
# Per ricavarlo:  hostname -I | awk '{print $1}'
SERVICE_IP=192.168.1.10
